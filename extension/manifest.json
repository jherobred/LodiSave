{
  "manifest_version": 3,
  "name": "LodiSave",
  "version": "0.1.0",
  "description": "Save the images and videos that sites block you from saving.",
  "permissions": ["contextMenus", "downloads", "scripting", "declarativeNetRequestWithHostAccess", "offscreen", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "LodiSave", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://youtu.be/*"],
      "js": ["hooks.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://youtu.be/*"],
      "js": ["shared.js", "rules.js", "hls.js", "dash.js", "mp4.js", "finder.js", "content.js", "picker.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}

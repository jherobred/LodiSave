<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: neither cloud backups nor a move to a new phone take the WebView's store,
     where Accounts keeps the sign-in cookies sites give. The rest backs up as before. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>

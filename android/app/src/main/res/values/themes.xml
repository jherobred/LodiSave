<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LodiSave" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
    <!-- The floating card: everything behind it stays visible. -->
    <style name="Theme.LodiSave.Floating" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
